# ============================================================
# AskForms — Self-Hosted Production Configuration
# Copy this file to .env before running `npm start`
# ============================================================

# Server
PORT=3840
HOST=0.0.0.0
PUBLIC_URL=https://forms.yourdomain.com.au

# Security
# ADMIN_PASSWORD locks the Designer Console (/)
# OWNER_PIN (6 digits) locks the mobile Client Daily Ops Portal (/manage)
ADMIN_PASSWORD=
OWNER_PIN=
SESSION_SECRET=

# Set to false for a blank production client installation (no demo forms)
SEED_DEMO=false

# Data Directory (SQLite database + uploaded file attachments)
DATA_DIR=./data

# Customer White-Label Defaults (can also be edited inside Brand & Hosting)
BRAND_NAME=AskForms
BRAND_WEBSITE_URL=https://yourdomain.com.au
SUPPORT_EMAIL=hello@yourdomain.com.au
LICENSE_HOLDER=Your Company Name
BRAND_LOGO_URL=
BRAND_ACCENT=#14383e
BRAND_ACCENT_TEXT=#ffffff
BRAND_BG=#f7fafc
BRAND_FONT=minimal
BRAND_RADIUS=balanced

# Optional Live Email Delivery via Resend (free up to 3,000 emails/month)
# Leave blank to capture rendered emails in the local Mail Outbox only
RESEND_API_KEY=
MAIL_FROM=forms@yourdomain.com.au
